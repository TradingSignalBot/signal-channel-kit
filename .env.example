# From @BotFather: /newbot
BOT_TOKEN=123456789:replace-with-your-token

# Your channel: @name for a public channel, or the -100... id of a private one
CHANNEL_ID=@your_channel

# Telegram user ids allowed to post, comma separated. Send /whoami to the bot to find yours.
ADMIN_IDS=123456789

# Where the log of every signal is kept (events.jsonl). Keep it on a volume: it is the record.
DATA_DIR=./data

# TradingView alerts: POST https://your-host/tradingview?key=<this>. Leave empty to turn alerts off.
# 16 characters or more. Make one with: node -e "console.log(crypto.randomUUID())"
WEBHOOK_SECRET=
PORT=8080

# The time zone posts are dated in, like Europe/London or America/New_York
TIME_ZONE=UTC

# The line under every signal. Set it empty to leave it off (you should not).
# RISK_LINE=Not financial advice. Trading on margin carries a high risk: you can lose more than you put in.

# Pip sizes the defaults get wrong (FX pairs, JPY pairs and gold are already right)
# PIP_SIZES=US30=1,BTCUSD=1

# The pinned record ends with a line naming this kit. CREDIT=off removes it.
# CREDIT=off
